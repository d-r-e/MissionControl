<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="org.missioncontrol.stadia.scanprobe" android:versionCode="2" android:versionName="0.1.1">
    <uses-sdk android:minSdkVersion="31" android:targetSdkVersion="36" />
